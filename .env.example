# GONKAFARM — contoh .env
#
# Salin jadi .env lalu isi. Script membaca otomatis, tidak perlu ubah kode:
#   cp .env.example .env

# ── WAJIB: sinkron ke 9router ──────────────────────────────────
# Password dashboard 9router (http://127.0.0.1:20128).
# Tanpa ini, sync key ke 9router dilewati.
ROUTER9_PASSWORD=

# ── opsional ───────────────────────────────────────────────────
# Waryono (SKIBIDIXXX) — hanya jika Turnstile diwajibkan (saat ini tidak).
# Default sudah ada di ~/credentials.txt, env ini menimpa.
WARYONO_API_KEY=

# Opsional: solver cadangan Nonecap
# NONECAP_API_KEY=nc_live_...
